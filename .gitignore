# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/test/.test-env.json
/test/.auth/
/test/e2e/scratch/
/test/.review-env.json
/.agent-uploads/
/.local-attachments/

# next.js
/.next/
/.next-validate/
/out/

# production
/build
/apps/*/dist
/apps/*/.astro

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers plugin
.superpowers/
/docs/superpowers/plans/*.md
/docs/superpowers/specs/*.md

# local agent/tooling artifacts
/.claude/*
!/.claude/skills/
/.tmp/
/.xero-evidence/
/entities.json
/mempalace.yaml
/scripts/peek-*.ts

# git worktrees
.worktrees/
.env*.local
