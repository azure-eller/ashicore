{
  "buildCommand": "pnpm drizzle-kit migrate && pnpm verify:production-schema && next build",
  "crons": [
    {
      "path": "/api/internal/inventory-reconciliation",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/xero-retry",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/internal/accounting-purchase-order-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/internal/xero-signup-cleanup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/process-imports",
      "schedule": "* * * * *"
    }
  ]
}
