---
import Analytics from "@vercel/analytics/astro";
import logo from "../assets/logo.svg";
import "../styles/global.css";
import {
  absoluteUrl,
  APP_ORIGIN,
  PUBLIC_SITE_URL,
  SIGN_IN_URL,
  SIGN_UP_URL,
  SITE_NAME,
} from "../lib/site";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const canonical = absoluteUrl(path);
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="en" data-palette="yellow">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href={APP_ORIGIN} crossorigin />
    <link rel="dns-prefetch" href={APP_ORIGIN} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={logo.src} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${PUBLIC_SITE_URL}/og.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Analytics />
    <div class="site-shell">
      <header class="nav" id="nav">
        <div class="wrap nav-inner">
          <a class="brand" href="/#top" aria-label="ashicore home">
            <span class="mark" aria-hidden="true">
              <svg viewBox="0 0 26 26" fill="none">
                <rect x="1" y="1" width="24" height="24" rx="7" fill="var(--ink)"></rect>
                <rect x="5.5" y="6" width="15" height="3.4" rx="1.7" fill="var(--accent)"></rect>
                <rect x="5.5" y="11.3" width="15" height="3.4" rx="1.7" fill="var(--bg)" opacity="0.9"></rect>
                <rect x="5.5" y="16.6" width="15" height="3.4" rx="1.7" fill="var(--accent-2)"></rect>
              </svg>
            </span>
            <span>ashicore</span>
          </a>
          <nav class="nav-links" aria-label="Primary">
            <a href="/#chain">What it handles</a>
            <a href="/#books">Accounting</a>
            <a href="/pricing">Pricing</a>
            <a href="/docs">Docs</a>
          </nav>
          <div class="nav-cta">
            <a
              href={SIGN_IN_URL}
              class="login"
              data-analytics-event="cta_login_clicked"
              data-analytics-placement="header"
              data-analytics-target="sign-in"
            >
              Log in
            </a>
            <a
              href={SIGN_UP_URL}
              class="btn btn-dark"
              data-analytics-event="cta_start_free_clicked"
              data-analytics-placement="header"
              data-analytics-plan="free"
              data-analytics-signup-start="true"
            >
              Start free
            </a>
          </div>
        </div>
      </header>
      <slot />
      <footer class="footer">
        <div class="wrap footer-grid">
          <div>
            <a class="brand" href="/#top">
              <span class="mark" aria-hidden="true">
                <svg viewBox="0 0 26 26" fill="none">
                  <rect x="1" y="1" width="24" height="24" rx="7" fill="var(--ink)"></rect>
                  <rect x="5.5" y="6" width="15" height="3.4" rx="1.7" fill="var(--accent)"></rect>
                  <rect x="5.5" y="11.3" width="15" height="3.4" rx="1.7" fill="var(--bg)" opacity="0.9"></rect>
                  <rect x="5.5" y="16.6" width="15" height="3.4" rx="1.7" fill="var(--accent-2)"></rect>
                </svg>
              </span>
              <span>ashicore</span>
            </a>
            <p class="blurb">
              Business software for soil, compost, fertilizer and amendment
              manufacturers.
            </p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/#chain">What it handles</a></li>
              <li><a href="/#books">Accounting sync</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="/docs">Docs</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="/security">Security</a></li>
              <li><a href="/resources">Resources</a></li>
              <li><a href="/support">Support</a></li>
              <li><a href="/subprocessors">Subprocessors</a></li>
            </ul>
          </div>
          <div>
            <h4>Get started</h4>
            <ul>
              <li>
                <a
                  href={SIGN_UP_URL}
                  data-analytics-event="cta_start_free_clicked"
                  data-analytics-placement="footer"
                  data-analytics-plan="free"
                  data-analytics-signup-start="true"
                >
                  Start free
                </a>
              </li>
              <li><a href="/support">Book a walkthrough</a></li>
              <li>
                <a
                  href={SIGN_IN_URL}
                  data-analytics-event="cta_login_clicked"
                  data-analytics-placement="footer"
                  data-analytics-target="sign-in"
                >
                  Log in
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="wrap footer-base">
          <span>© 2026 ashicore, Inc.</span>
          <span>
            Built for producers · <a href="/privacy">Privacy</a> · <a href="/data-deletion">Data deletion</a> · <a href="/terms">Terms</a>
          </span>
        </div>
      </footer>
    </div>
    <script is:inline src="/marketing-main.js" defer></script>
  </body>
</html>
