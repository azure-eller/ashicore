---
import type { MarkdownHeading } from "astro";
import type { DocEntry } from "../lib/docs";
import BaseLayout from "./BaseLayout.astro";
import { docUrl, groupDocs } from "../lib/docs";

interface Props {
  title: string;
  description: string;
  path: string;
  allDocs: DocEntry[];
  activeId?: string;
  headings?: MarkdownHeading[];
}

const { title, description, path, allDocs, activeId, headings = [] } = Astro.props;
const groups = groupDocs(allDocs);
const activeIndex = allDocs.findIndex((entry) => entry.id === activeId);
const previousDoc = activeIndex > 0 ? allDocs[activeIndex - 1] : null;
const nextDoc = activeIndex >= 0 ? allDocs[activeIndex + 1] : null;
const pageHeadings = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={description} path={path}>
  <main class="docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a class="docs-home-link" href="/docs">Documentation</a>
      <div class="docs-search" role="search">
        <label for="docs-search-input">Search docs</label>
        <input
          id="docs-search-input"
          type="search"
          autocomplete="off"
          placeholder="Search inventory, orders, lots..."
        />
        <div id="docs-search-results" class="docs-search-results" hidden></div>
      </div>
      {
        groups.map((group) => (
          <section class="docs-nav-group">
            <h2>{group.section}</h2>
            <ul>
              {group.entries.map((entry) => (
                <li>
                  <a
                    href={docUrl(entry)}
                    aria-current={entry.id === activeId ? "page" : undefined}
                  >
                    {entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </aside>
    <div class="docs-main">
      <article class="docs-article">
        <header class="docs-article-header">
          <p class="docs-label">Ashicore docs</p>
          <h1>{title}</h1>
          <p>{description}</p>
        </header>
        <div class="docs-content">
          <slot />
        </div>
        {
          activeId ? (
            <nav class="docs-pagination" aria-label="Documentation pagination">
              {previousDoc ? (
                <a href={docUrl(previousDoc)}>
                  <span>Previous</span>
                  {previousDoc.data.title}
                </a>
              ) : (
                <span />
              )}
              {nextDoc ? (
                <a href={docUrl(nextDoc)} class="next">
                  <span>Next</span>
                  {nextDoc.data.title}
                </a>
              ) : null}
            </nav>
          ) : null
        }
      </article>
      {
        pageHeadings.length > 0 ? (
          <aside class="docs-toc" aria-label="On this page">
            <h2>On this page</h2>
            {pageHeadings.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </aside>
        ) : null
      }
    </div>
  </main>
  <script>
    const input = document.querySelector<HTMLInputElement>("#docs-search-input");
    const results = document.querySelector<HTMLElement>("#docs-search-results");
    type SearchEntry = {
      title: string;
      description: string;
      section: string;
      url: string;
      text: string;
    };
    let searchIndex: SearchEntry[] | null = null;

    async function getSearchIndex(): Promise<SearchEntry[]> {
      if (searchIndex) return searchIndex;
      const response = await fetch("/docs/search.json");
      const entries = (await response.json()) as SearchEntry[];
      searchIndex = entries;
      return entries;
    }

    function renderResults(matches: SearchEntry[]) {
      if (!results) return;

      if (!matches || matches.length === 0) {
        results.hidden = true;
        results.innerHTML = "";
        return;
      }

      results.hidden = false;
      results.innerHTML = matches
        .slice(0, 6)
        .map(
          (match) => `
            <a href="${match.url}">
              <span>${match.section}</span>
              <strong>${match.title}</strong>
              <small>${match.description}</small>
            </a>
          `
        )
        .join("");
    }

    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();

      if (query.length < 2) {
        renderResults([]);
        return;
      }

      void getSearchIndex().then((entries) => {
        const terms = query.split(/\s+/);
        const matches = entries.filter((entry) =>
          terms.every((term) =>
            `${entry.title} ${entry.description} ${entry.section} ${entry.text}`
              .toLowerCase()
              .includes(term)
          )
        );
        renderResults(matches);
      });
    });

    document.addEventListener("click", (event) => {
      if (!results || !input) return;
      const target = event.target;
      if (target instanceof Node && (results.contains(target) || input.contains(target))) {
        return;
      }
      renderResults([]);
    });
  </script>
</BaseLayout>
