---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SIGN_UP_URL } from "../lib/site";

const PRO_SIGN_UP_URL = `${SIGN_UP_URL}?plan=pro`;
---

<BaseLayout
  title="Pricing"
  description="Start free with every Ashicore feature and up to 30 active SKUs. Upgrade to Pro for $199 per month when you need unlimited SKUs."
  path="/pricing"
>
  <main id="top">
    <section class="pp-section">
      <div class="wrap">
        <div class="pp-head">
          <span class="eyebrow">Pricing</span>
          <h1 class="h-display">The whole ERP. Two plans.</h1>
          <p class="lede">
            Start free with every feature, unlimited users, integrations and locations.
            Move to Pro only when your catalog grows beyond 30 active SKUs.
          </p>
          <div class="pp-pillrow">
            <span class="pp-pill">No credit card</span>
            <span class="pp-pill">No time limit</span>
            <span class="pp-pill">No per-seat pricing</span>
          </div>
        </div>

        <div class="pp-cards">
          <div class="pp-card">
            <div class="pp-card-name">Free</div>
            <div class="pp-card-price"><span class="num">$0</span><span class="per">forever</span></div>
            <p class="pp-card-desc">Run a focused operation or evaluate Ashicore on your real data without a deadline.</p>
            <span class="pp-card-meta">15 days of unlimited SKU creation</span>
            <hr />
            <ul class="pp-card-list">
              <li><span class="ck">✓</span><span><b>30 active SKUs</b> after the first 15 days</span></li>
              <li><span class="ck">✓</span><span>Every released ERP feature</span></li>
              <li><span class="ck">✓</span><span>Unlimited users, integrations and locations</span></li>
              <li><span class="ck">✓</span><span>AI onboarding and mobile app</span></li>
            </ul>
            <a
              href={`${SIGN_UP_URL}?plan=free`}
              class="btn btn-ghost"
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement="pricing-page"
              data-analytics-plan="free"
              data-analytics-signup-start="true"
            >
              Start free
            </a>
          </div>

          <div class="pp-card rec">
            <span class="pp-card-tag"><i></i> Unlimited catalog</span>
            <div class="pp-card-name">Pro</div>
            <div class="pp-card-price"><span class="num">$199</span><span class="per">/month</span></div>
            <p class="pp-card-desc">The same complete product with no SKU ceiling and one predictable monthly bill.</p>
            <span class="pp-card-meta">Cancel anytime</span>
            <hr />
            <ul class="pp-card-list">
              <li><span class="ck">✓</span><span><b>Unlimited active SKUs</b></span></li>
              <li><span class="ck">✓</span><span>Every released ERP feature</span></li>
              <li><span class="ck">✓</span><span>Unlimited users, integrations and locations</span></li>
              <li><span class="ck">✓</span><span>No order bands, add-ons or usage charges</span></li>
            </ul>
            <a
              href={PRO_SIGN_UP_URL}
              class="btn btn-primary"
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement="pricing-page"
              data-analytics-plan="pro"
              data-analytics-signup-start="true"
            >
              Start Pro <span class="arr">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pp-section tight" style="background:var(--bg-2); border-block:1px solid var(--line);">
      <div class="wrap">
        <div class="pp-head">
          <span class="eyebrow">The only limit</span>
          <h2 class="h-section">A SKU is an active product, material or variant.</h2>
          <p class="lede">
            Free workspaces keep every feature. After the 15-day setup window, creating a 31st active SKU requires Pro. Existing records and workflows are never removed or locked.
          </p>
        </div>
      </div>
    </section>

    <section class="section cta-band">
      <div class="wrap">
        <div class="inner">
          <span class="eyebrow on-dark">Get started</span>
          <h2 class="h-section">Build the system before you buy it.</h2>
          <p class="lede">Bring your real catalog. No card, no deadline, no stripped-down demo.</p>
          <div class="hero-cta">
            <a
              href={`${SIGN_UP_URL}?plan=free`}
              class="btn btn-primary btn-lg"
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement="pricing-cta"
              data-analytics-plan="free"
              data-analytics-signup-start="true"
            >
              Start free <span class="arr">→</span>
            </a>
            <a href="/support" class="btn btn-ghost btn-lg" style="color:var(--on-ground); border-color:var(--ground-line);">Book a walkthrough</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
