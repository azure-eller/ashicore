---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SIGN_UP_URL } from "../lib/site";

const freeSignupUrl = `${SIGN_UP_URL}?plan=free`;
const paidSignupUrl = `${SIGN_UP_URL}?plan=paid`;
---

<BaseLayout
  title="Pricing"
  description="Ashicore has a free plan for small manufacturers getting started and a flat paid plan at $199/month for unlimited SKUs."
  path="/pricing"
>
    <main class="content-page">
    <p class="kicker">Pricing</p>
    <h1 class="page-title">Start free. Upgrade when the SKU limit gets in the way.</h1>
    <p class="page-description">
      Ashicore gives small manufacturers operational control across inventory,
      manufacturing, sales, purchasing, and planning. Free has no time limit and
      does not require a credit card.
    </p>

    <section class="pricing-panel two-up" aria-label="Ashicore plans">
      <article class="pricing-card">
        <p class="plan-name">Free</p>
        <p class="pricing-price">
          <span class="price-main">$0</span>
          <span class="price-period">forever</span>
        </p>
        <p class="price-term">No credit card. Up to 30 SKUs.</p>
        <ul class="pricing-list">
          <li>Inventory, manufacturing, sales, purchasing, and planning workflows.</li>
          <li>30-SKU cap across products, materials, variants, and imported items.</li>
          <li>All current data stays readable if the account goes over the limit.</li>
        </ul>
        <div class="hero-actions">
          <a class="button secondary" href={freeSignupUrl}>Create free account</a>
        </div>
      </article>

      <article class="pricing-card highlighted">
        <p class="plan-name">Paid</p>
        <p class="pricing-price">
          <span class="price-main">$199</span>
          <span class="price-period">/ month</span>
        </p>
        <p class="price-term">Flat monthly price. Unlimited SKUs.</p>
        <ul class="pricing-list">
          <li>Inventory, manufacturing, sales, purchasing, and planning workflows.</li>
          <li>Unlimited products, materials, variants, and imported catalog items.</li>
          <li>Stripe Checkout for upgrade and Stripe Customer Portal for billing changes.</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href={paidSignupUrl}>Create account</a>
        </div>
      </article>
    </section>

    <article class="content-body">
      <h2>How signup works</h2>
      <p>
        New teams create an Ashicore account, secure it with MFA, and create an
        organization. Free opens the app immediately. Paid continues to Stripe
        Checkout after the organization is ready.
      </p>
      <p>
        Canceling the paid plan never deletes catalog data. If the organization returns
        to Free with more than 30 SKUs, existing items remain available and new
        SKU creation is blocked until the plan is upgraded or the count is back
        under the limit.
      </p>
    </article>
  </main>
</BaseLayout>
