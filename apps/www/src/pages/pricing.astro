---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  EVERYTHING_SIGN_UP_URL,
  SOIL_LANDSCAPE_SIGN_UP_URL,
  SIGN_UP_URL,
} from "../lib/site";
---

<BaseLayout
  title="Pricing"
  description="Start Ashicore free, then add plugin upgrades, packages, or Everything when you need them."
  path="/pricing"
>
  <main class="content-page pricing-page">
    <div class="price-head">
      <span class="eyebrow">Pricing</span>
      <h1 class="h-section">Choose how you'd like to start.</h1>
      <p class="lede">
        Start free. Add only the paid workflows you need.
      </p>
    </div>

    <div class="price-grid">
      <section class="plan free">
        <div class="plan-top">
          <span class="plan-name">Free</span>
          <span class="plan-price">$0<span class="per">/mo</span></span>
        </div>
        <p class="plan-desc">
          A complete operating system for small teams.
        </p>
        <ul class="plan-list">
          <li><span class="ck">✓</span> Unlimited SKUs</li>
          <li><span class="ck">✓</span> Manufacturing, sales, purchasing</li>
          <li><span class="ck">✓</span> AI-assisted data entry</li>
          <li><span class="ck">✓</span> Integrations included</li>
        </ul>
        <a
          href={SIGN_UP_URL}
          class="btn btn-ghost"
          data-analytics-event="pricing_plan_clicked"
          data-analytics-placement="pricing-page"
          data-analytics-plan="free"
          data-analytics-signup-start="true"
        >
          Start free
        </a>
      </section>

      <section class="plan">
        <div class="plan-top">
          <span class="plan-name">Plugins</span>
          <span class="plan-price">$99<span class="per">/mo</span></span>
        </div>
        <p class="plan-desc">
          Add focused workflows one at a time.
        </p>
        <ul class="plan-list">
          <li><span class="ck">✓</span> Lot tracking</li>
          <li><span class="ck">✓</span> Batch production</li>
          <li><span class="ck">✓</span> CRM, pricing, or locations</li>
        </ul>
        <a
          href={SIGN_UP_URL}
          class="btn btn-ghost"
          data-analytics-event="pricing_plan_clicked"
          data-analytics-placement="pricing-page"
          data-analytics-plan="plugin"
          data-analytics-signup-start="true"
        >
          Start free
        </a>
      </section>

      <section class="plan rec">
        <span class="plan-tag-rec">Recommended</span>
        <div class="plan-top">
          <span class="plan-name">Packages</span>
          <span class="plan-price">$199<span class="per">/mo</span></span>
        </div>
        <p class="plan-desc">
          Three-plugin bundles for common operators.
        </p>
        <ul class="plan-list">
          <li><span class="ck">✓</span> Food &amp; Bev</li>
          <li><span class="ck">✓</span> Soil &amp; Landscape</li>
          <li><span class="ck">✓</span> Wholesale B2B</li>
        </ul>
        <a
          href={SOIL_LANDSCAPE_SIGN_UP_URL}
          class="btn btn-primary"
          data-analytics-event="pricing_plan_clicked"
          data-analytics-placement="pricing-page"
          data-analytics-plan="package_soil_landscape"
          data-analytics-signup-start="true"
        >
          Choose package <span class="arr">→</span>
        </a>
      </section>

      <section class="plan">
        <div class="plan-top">
          <span class="plan-name">Everything</span>
          <span class="plan-price">$399<span class="per">/mo</span></span>
        </div>
        <p class="plan-desc">
          Every plugin in one subscription.
        </p>
        <ul class="plan-list">
          <li><span class="ck">✓</span> All current plugins</li>
          <li><span class="ck">✓</span> 33% bundle discount</li>
          <li><span class="ck">✓</span> Founding price lock</li>
        </ul>
        <a
          href={EVERYTHING_SIGN_UP_URL}
          class="btn btn-ghost"
          data-analytics-event="pricing_plan_clicked"
          data-analytics-placement="pricing-page"
          data-analytics-plan="everything"
          data-analytics-signup-start="true"
        >
          Choose Everything
        </a>
      </section>
    </div>
    <p class="price-foot">
      No card required for Free · switch anytime · monthly only at launch
    </p>
  </main>
</BaseLayout>
