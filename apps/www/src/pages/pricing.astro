---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SIGN_UP_URL } from "../lib/site";
---

<BaseLayout
  title="Pricing"
  description="Start Ashicore free, then scale into unlimited SKUs, locations, integrations, and priority onboarding."
  path="/pricing"
>
  <main class="content-page pricing-page">
    <div class="price-head">
      <span class="eyebrow">Pricing</span>
      <h1 class="h-section">Choose how you'd like to start.</h1>
      <p class="lede">
        Switch plans anytime. No card required to begin.
      </p>
    </div>

    <div class="price-grid">
      <section class="plan free">
        <div class="plan-top">
          <span class="plan-name">Free</span>
          <span class="plan-price">$0<span class="per">/mo</span></span>
        </div>
        <p class="plan-desc">
          Get up and running fast with AI-assisted data entry, on us.
        </p>
        <ul class="plan-list">
          <li><span class="ck">✓</span> Up to 50 SKUs</li>
          <li><span class="ck">✓</span> AI-assisted data entry</li>
          <li><span class="ck">✓</span> Unlimited users</li>
          <li><span class="ck">✓</span> 1 location</li>
        </ul>
        <a href={SIGN_UP_URL} class="btn btn-ghost">Start free</a>
      </section>

      <section class="plan rec">
        <span class="plan-tag-rec">Recommended</span>
        <div class="plan-top">
          <span class="plan-name">Pro</span>
          <span class="plan-price">$199<span class="per">/mo</span></span>
        </div>
        <p class="plan-desc">
          Scale up with unlimited SKUs, locations, and integrations.
        </p>
        <ul class="plan-list">
          <li><span class="ck">✓</span> Unlimited SKUs &amp; recipes</li>
          <li><span class="ck">✓</span> Everything in Free</li>
          <li><span class="ck">✓</span> Multi-location inventory</li>
          <li><span class="ck">✓</span> Integrations including Shopify and QBO</li>
          <li><span class="ck">✓</span> Priority onboarding &amp; support</li>
        </ul>
        <a href={SIGN_UP_URL} class="btn btn-primary">Choose Pro <span class="arr">→</span></a>
      </section>
    </div>
    <p class="price-foot">
      No card required to start · switch plans anytime · cancel whenever
    </p>
  </main>
</BaseLayout>
