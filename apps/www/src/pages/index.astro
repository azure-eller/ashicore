---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SIGN_UP_URL } from "../lib/site";

const stages = [
  {
    object: "material",
    title: "Inbound and freight",
    yard: "The bark is on one invoice. The freight is on another, and it lands a week later. What the yard actually paid per unit is on neither one.",
    app: "A purchase order carries its additional costs beside the material lines. Distribute freight, customs and handling by line value or by ordered purchase quantity, or leave a deposit out of stock cost entirely.",
    fact: "Landed cost per stock unit becomes the lot cost at receipt. Change a cost after receiving and the lots still on hand revalue.",
  },
  {
    object: "recipe",
    title: "Formulas and their history",
    yard: "The mix lives in a spreadsheet, or in the head of the one person who formulates. When it changes, nobody writes down why.",
    app: "The formula lives on the product. Every changed save appends a revision holding the components, the constraints, the operation costs, who saved it and a note. One revision is current.",
    fact: "Manufacturing orders copy the current revision, so editing a formula never rewrites a run you already made. Lock a proven formula and it stops taking quiet edits.",
  },
  {
    object: "ingredient",
    title: "Ingredients and packaging",
    yard: "Peat, coir, perlite, bark, lime. Then the bags, totes and labels that also have to be on hand before anything can run.",
    app: "Packaging is a material in the formula like any other input, so a run that is short on 1 cu ft bags reads as short instead of ready. A component can name which sibling variants may stand in for it, each with its own quantity in its own unit.",
    fact: "Swap a component to an approved variant while the row is still unpicked. Once picking starts the row locks, because the inventory trail already points at those lots.",
  },
  {
    object: "batch",
    title: "Batches and production",
    yard: "Nobody makes 137 yards. They make four batches of whatever the mixer holds, and the fourth one comes up short.",
    app: "A formula is written per unit or per batch. A batch order runs a whole number of batches against a planned output, and ingredient demand scales from the batch count.",
    fact: "Each batch carries its own status and its own output lot, so a run can complete in pieces instead of all at once.",
  },
  {
    object: "lot",
    title: "Curing and age rules",
    yard: "Compost is not compost the day it is turned. Material that has not sat long enough should not end up in a bag with your name on it.",
    app: "A formula component can require lots to be at least a set number of days old, counted from the date the lot was received.",
    fact: "Picking takes eligible lots first. When nothing is old enough it shows need, have and short before you can continue, and records the override if you go ahead.",
  },
  {
    object: "variant",
    title: "One blend, several package sizes",
    yard: "The same mix leaves as a 1.5 cu ft bag, a 2 cu ft bag, a tote and loose by the yard. Four prices, four counts, one formula.",
    app: "A family holds the shared identity: name, units, lot-tracking mode, purchasing setup. Each size stays a real item with its own SKU, price, stock, lots and ledger history.",
    fact: "A pricing schedule can target one option value, such as every 2 cu ft bag, for a customer category with quantity breaks.",
  },
  {
    object: "balance",
    title: "What is on hand, and what is coming",
    yard: "A landscaper asks for forty yards on Friday. The answer is split between two people and a stack of open purchase orders.",
    app: "Every item reads on hand, demand, expected and available to promise, per location. Only available stock counts. Blocked and rejected quantity stays on the lot for the record but out of use.",
    fact: "Open sales lines and manufacturing ingredient demand compete for the same stock in rank order, so scarce material is steered by ranking orders.",
  },
  {
    object: "order",
    title: "Orders, fulfillment and shipping",
    yard: "Half the order can go today and the rest when the next batch is ready. The customer wants to know which half, and when.",
    app: "Each line reads three ways: whether the finished good is there, whether the components are coverable, and whether production has to run. Those roll up into one readiness answer for the order.",
    fact: "Ship part of an order and the shipped rows are protected. Cancel what is left and the order closes with its history intact.",
  },
  {
    object: "cost",
    title: "What it actually cost to make",
    yard: "The per-yard cost behind the price list was worked out two seasons ago, before freight moved and before the mix changed.",
    app: "The formula shows an estimate per output unit from current stock costs plus operations. When a run completes, Ashicore reconciles the quantities and lot costs that were actually consumed.",
    fact: "Actual material cost, absorbed operation cost and actual cost per unit, recorded on the order that produced it.",
  },
];
---

<BaseLayout
  title="Ashicore"
  description="Ashicore is business software for soil, compost, fertilizer and amendment manufacturers. Formulas and their revisions, batches, cure rules, package sizes, landed freight, orders and real cost per unit in one system."
  path="/"
>
  <main id="top">

    <!-- ===================== HERO ===================== -->
    <section class="section hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow reveal">Soil · Compost · Fertilizer · Amendments</span>
          <h1 class="h-display reveal d1">
            Business software for<br /><span class="hl">soil manufacturers.</span>
          </h1>
          <p class="lede reveal d2">
            Compost, potting mixes, growing media, amendment and fertilizer
            blends. Ashicore holds the formula, the batch, the cure rule, the
            package sizes, the inbound freight and the real cost per unit in one
            system instead of six spreadsheets.
          </p>
          <div class="hero-cta reveal d3">
            <a
              href={SIGN_UP_URL}
              class="btn btn-primary btn-lg"
              data-analytics-event="cta_start_free_clicked"
              data-analytics-placement="hero"
              data-analytics-plan="free"
              data-analytics-signup-start="true"
            >
              Start free <span class="arr">→</span>
            </a>
            <a href="#chain" class="btn btn-ghost btn-lg">What it handles</a>
          </div>
          <p class="hero-note reveal d3">
            Start with one blend. Keep its formula, batches, lots, package sizes,
            orders and costs connected.
          </p>
        </div>

        <!-- SIGNATURE: a formula drawn as a soil profile -->
        <figure
          class="profile reveal d2"
          aria-label="An illustrative product formula in Ashicore: Raised-Bed Blend, revision 4, made of 50 percent screened compost, 30 percent screened topsoil and 20 percent bark fines."
        >
          <figcaption class="profile-head">
            <span class="profile-kind">Example product formula</span>
            <span class="profile-name">Raised-Bed Blend</span>
            <span class="profile-rev">rev 4 · current</span>
          </figcaption>

          <div class="profile-stack" aria-hidden="true">
            <div class="horizon h-1" style="--share: 50">
              <span class="horizon-share">50%</span>
              <span class="horizon-name">Screened compost</span>
              <span class="horizon-note">30+ day lots</span>
            </div>
            <div class="horizon h-2" style="--share: 30">
              <span class="horizon-share">30%</span>
              <span class="horizon-name">Screened topsoil</span>
              <span class="horizon-note">fifo</span>
            </div>
            <div class="horizon h-3" style="--share: 20">
              <span class="horizon-share">20%</span>
              <span class="horizon-name">Bark fines</span>
              <span class="horizon-note">2 variants</span>
            </div>
          </div>

          <dl class="profile-facts">
            <div><dt>Basis</dt><dd>per batch · 300 yd³</dd></div>
            <div><dt>Sells as</dt><dd>bulk yd³ · 2 cu ft · 1.5 cu ft</dd></div>
            <div><dt>Est. cost</dt><dd>material + operations, per yd³</dd></div>
          </dl>
        </figure>
      </div>
    </section>

    <!-- ===================== WHO ===================== -->
    <section class="segments">
      <div class="wrap segments-inner">
        <span class="segments-label">Made for</span>
        <span class="segment">Compost producers</span>
        <span class="segment">Soil and mulch blenders</span>
        <span class="segment">Potting and growing media</span>
        <span class="segment">Fertilizer and amendment makers</span>
      </div>
    </section>

    <!-- ===================== THE SPREAD (dark) ===================== -->
    <section class="section dark spread">
      <div class="wrap spread-grid">
        <div class="reveal">
          <span class="eyebrow on-dark">The problem</span>
          <h2 class="h-section">Six places, none of&nbsp;them talking.</h2>
        </div>
        <div class="spread-body reveal d1">
          <ul class="spread-list">
            <li><span>The formula</span> a spreadsheet, two versions old</li>
            <li><span>What is on hand</span> a walk around the pad</li>
            <li><span>The freight</span> a bill in the bookkeeper's inbox</li>
            <li><span>The bag sizes</span> a price list in a shared drive</li>
            <li><span>The cure dates</span> a whiteboard by the windrows</li>
            <li><span>The cost per yard</span> a number from two seasons ago</li>
          </ul>
          <p class="lede">
            Every one of those is a fact about the same material. Ashicore keeps
            one record for the thing you make and hangs all six off it, so
            changing the formula changes the cost, and receiving a load changes
            what you can promise.
          </p>
        </div>
      </div>
    </section>

    <!-- ===================== THE CHAIN ===================== -->
    <section class="section chain" id="chain">
      <div class="wrap">
        <header class="chain-head reveal">
          <span class="eyebrow">What it handles</span>
          <h2 class="h-section">
            Follow one load of material from the gate to the invoice.
          </h2>
          <p class="lede">
            These are the places a soil operation actually loses money and time.
            Each one is a record in Ashicore, and each one knows about the next.
          </p>
        </header>

        <div class="chain-cols" aria-hidden="true">
          <span class="chain-col-label">In the yard</span>
          <span class="chain-col-label">In Ashicore</span>
        </div>

        <ol class="chain-list">
          {
            stages.map((stage) => (
              <li class="stage reveal">
                <div class="stage-mark">
                  <span class="stage-object">{stage.object}</span>
                </div>
                <div class="stage-body">
                  <h3 class="stage-title">{stage.title}</h3>
                  <div class="stage-cols">
                    <p class="stage-yard">{stage.yard}</p>
                    <p class="stage-app">{stage.app}</p>
                  </div>
                  <p class="stage-fact">{stage.fact}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ===================== CONNECTED ===================== -->
    <section class="section connected" id="books">
      <div class="wrap">
        <header class="chain-head reveal">
          <span class="eyebrow">Where it ends</span>
          <h2 class="h-section">Your books stay your books.</h2>
        </header>
        <div class="two-up">
          <div class="col reveal">
            <h3>Xero or QuickBooks</h3>
            <p>
              Connect one provider. Sales invoices go out on shipment,
              automatically on Xero or with one action on QuickBooks. A supplier
              bill is raised from a purchase order when you choose to raise it,
              never as a side effect of receiving. Open purchase orders come the
              other way so you can receive against an order raised in your
              accounting system, and Xero contacts can be pulled in as customers
              and suppliers.
            </p>
            <p class="col-fact">
              Ashicore keeps no ledger of its own. Your accounting system stays
              the book of record.
            </p>
            <a class="col-link" href="/docs/integrations/accounting-sync">
              How accounting sync works <span class="arr">→</span>
            </a>
          </div>
          <div class="col reveal d1">
            <h3>Shipment and invoicing stay connected</h3>
            <p>
              A sales order keeps ordered, allocated, picked, shipped and
              cancelled quantities on each line. Ship what is ready now, leave
              the balance open, and send the eligible invoice to your connected
              accounting provider.
            </p>
            <p class="col-fact">
              A failed invoice push never blocks the shipment and is safe to
              retry.
            </p>
            <a class="col-link" href="/docs/sales/deliver-and-invoice">
              How delivery and invoicing work <span class="arr">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== PRICING ===================== -->
    <section class="section pricing-band" id="pricing">
      <div class="wrap">
        <div class="price-head reveal">
          <span class="eyebrow">Pricing</span>
          <h2 class="h-section">Free until your catalog is big.</h2>
          <p class="lede">
            Every feature is free for up to 30 active SKUs. For a soil maker a
            SKU is one sellable item, so six blends in three bag sizes is
            eighteen. Pro is $199 per month when the catalog outgrows that.
          </p>
        </div>

        <div class="pp-cards">
          <!-- Free -->
          <div class="pp-card reveal">
            <div class="pp-card-name">Free</div>
            <div class="pp-card-price"><span class="num">$0</span><span class="per">forever</span></div>
            <p class="pp-card-desc">
              The whole system, with no time limit and no card.
            </p>
            <span class="pp-card-meta">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
              15 days of unlimited SKU creation to get set up
            </span>
            <hr />
            <ul class="pp-card-list">
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span><b>30 active SKUs</b> after the first 15 days</span></li>
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span>Formulas, revisions, batches and lots</span></li>
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span><b>Unlimited users</b> from day one</span></li>
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span>Accounting sync included</span></li>
            </ul>
            <a
              href={SIGN_UP_URL}
              class="btn btn-ghost"
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement="home-pricing"
              data-analytics-plan="free"
              data-analytics-signup-start="true"
            >
              Start free
            </a>
          </div>

          <!-- Pro -->
          <div class="pp-card rec reveal d1">
            <span class="pp-card-tag"><i></i> Unlimited catalog</span>
            <div class="pp-card-name">Pro</div>
            <div class="pp-card-price"><span class="num">$199</span><span class="per">/month</span></div>
            <p class="pp-card-desc">
              The same system with no ceiling on how many items you sell.
            </p>
            <hr />
            <ul class="pp-card-list">
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span><b>Unlimited</b> SKUs, users and integrations</span></li>
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span>Every blend, every size, every location</span></li>
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span><b>No order bands</b> or usage charges</span></li>
              <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg></span><span>All released features included</span></li>
            </ul>
            <a
              href={`${SIGN_UP_URL}?plan=pro`}
              class="btn btn-primary"
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement="home-pricing"
              data-analytics-plan="pro"
            >
              Get started <span class="arr">→</span>
            </a>
          </div>
        </div>
        <p class="price-foot">
          Exactly how the 30-SKU limit counts is on the
          <a href="/pricing" class="price-foot-link">full pricing page →</a>
        </p>
      </div>
    </section>

    <!-- ===================== FINAL CTA ===================== -->
    <section class="section cta-band">
      <div class="wrap">
        <div class="inner reveal">
          <span class="eyebrow on-dark">Get started</span>
          <h2 class="h-section">Load one blend and see if it fits.</h2>
          <p class="lede">
            Set up a formula, run a batch against it, and check the cost that
            comes out the other side. If it does not match how your yard
            actually runs, tell us what is missing.
          </p>
          <div class="hero-cta">
            <a
              href={SIGN_UP_URL}
              class="btn btn-primary btn-lg"
              data-analytics-event="cta_start_free_clicked"
              data-analytics-placement="final-cta"
              data-analytics-plan="free"
              data-analytics-signup-start="true"
            >
              Start free <span class="arr">→</span>
            </a>
            <a
              href="/support"
              class="btn btn-ghost btn-lg"
              style="color: var(--on-ground); border-color: var(--ground-line);"
            >
              Talk to us first
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
