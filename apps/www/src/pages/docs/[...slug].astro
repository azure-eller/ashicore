---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { compareDocs, docSlug, docUrl } from "../../lib/docs";

export async function getStaticPaths() {
  const allDocs = (await getCollection("docs")).sort(compareDocs);

  return allDocs.map((entry) => ({
    params: { slug: docSlug(entry) },
    props: { entry, allDocs },
  }));
}

const { entry, allDocs } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  path={docUrl(entry)}
  allDocs={allDocs}
  activeId={entry.id}
  headings={headings}
>
  <Content />
</DocsLayout>
