---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SIGN_IN_URL } from "../lib/site";
---

<BaseLayout
  title="Page not found"
  description="The requested Ashicore page could not be found."
  path="/404"
>
  <main class="content-page">
    <p class="kicker">404</p>
    <h1 class="page-title">Page not found.</h1>
    <p class="page-description">
      The link may be stale, or the route may belong to the authenticated app.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/support">Support</a>
      <a class="btn btn-ghost" href={SIGN_IN_URL}>Sign in</a>
    </div>
  </main>
</BaseLayout>
