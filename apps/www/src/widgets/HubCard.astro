---
/**
 * Doc UI kit — HubCard: a how-to card for the module hub grid.
 *
 * Models the Carime handoff's `.dcard` (accent-soft icon tile + index +
 * title + one-liner). Token-themed; sits inside a `<div class="po-cardgrid">`.
 * Icons are small inline doc glyphs (the handoff draws them inline, no icon
 * dependency); the app itself standardizes on HugeIcons.
 */
interface Props {
  href: string;
  n: string;
  title: string;
  desc: string;
  icon: "plus" | "arrow" | "box" | "coin" | "doc" | "supplier";
}

const { href, n, title, desc, icon } = Astro.props;

const ICONS: Record<Props["icon"], string> = {
  plus: '<path d="M12 5v14M5 12h14"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  box: '<path d="M4 7v10l8 4 8-4V7l-8-4-8 4z"/>',
  coin: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 4.5 1.5c0 1.5-2 2-2 3.5M12 17h.01"/>',
  doc: '<path d="M6 3h8l4 4v14H6zM14 3v4h4"/>',
  supplier: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M17 11l2 2 4-4"/>',
};
---

<a class="po-dcard" href={href}>
  <div class="dc-top">
    <span class="dc-ico">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={ICONS[icon]} />
    </span>
    <span class="dc-n">{n}</span>
  </div>
  <div class="dc-t">{title}</div>
  <div class="dc-d">{desc}</div>
</a>
