---
import {
  EVERYTHING_SIGN_UP_URL,
  SIGN_UP_URL,
  SOIL_LANDSCAPE_SIGN_UP_URL,
} from "../lib/site";

interface Props {
  id?: string;
  placement: string;
  section?: boolean;
}

const { id, placement, section = false } = Astro.props;
const Heading = section ? "h2" : "h1";

const pluginPrice = 99;
const freeIncludes = [
  "Unlimited SKUs",
  "Manufacturing, sales & purchasing",
  "Real-time inventory",
  "AI onboarding & data entry",
  "Unlimited users",
  "Single location",
  "Full mobile app included",
  "Integrations included",
];

const plugins = [
  { id: "lot", name: "Lot tracking" },
  { id: "batch", name: "Batch production" },
  { id: "crm", name: "CRM" },
  { id: "price", name: "Wholesale pricing" },
  { id: "multi", name: "Multi-location" },
];

const nodes = [
  {
    id: "foodbev",
    kind: "Package · 01",
    name: "Food & Bev",
    price: 199,
    angle: -90,
    desc: "Trace every batch from ingredient intake to shipment.",
    plugins: ["Lot tracking", "Batch production", "Wholesale pricing"],
    href: `${SIGN_UP_URL}?plan=package_food_bev`,
    analyticsPlan: "package_food_bev",
    path: "M 61.24 55.58 A 172 172 0 0 1 298.76 55.58 L 244.99 109.35 A 96 96 0 0 0 115.01 109.35 Z",
  },
  {
    id: "soil",
    kind: "Package · 02",
    name: "Soil & Landscape",
    price: 199,
    angle: 0,
    desc: "Mix, bag, stock, and sell across yards, stores, and wholesale customers.",
    plugins: ["Batch production", "Multi-location", "Wholesale pricing"],
    href: SOIL_LANDSCAPE_SIGN_UP_URL,
    analyticsPlan: "package_soil_landscape",
    path: "M 304.42 61.24 A 172 172 0 0 1 304.42 298.76 L 250.65 244.99 A 96 96 0 0 0 250.65 115.01 Z",
  },
  {
    id: "wholesale",
    kind: "Package · 03",
    name: "Wholesale B2B",
    price: 199,
    angle: 90,
    desc: "Manage repeat buyers, price breaks, and inventory across locations.",
    plugins: ["CRM", "Wholesale pricing", "Multi-location"],
    href: `${SIGN_UP_URL}?plan=package_wholesale_b2b`,
    analyticsPlan: "package_wholesale_b2b",
    path: "M 298.76 304.42 A 172 172 0 0 1 61.24 304.42 L 115.01 250.65 A 96 96 0 0 0 244.99 250.65 Z",
  },
  {
    id: "everything",
    kind: "All plugins",
    name: "Everything",
    price: 399,
    angle: 180,
    desc: "Every plugin in one subscription — the full toolkit.",
    plugins: plugins.map((plugin) => plugin.name),
    href: EVERYTHING_SIGN_UP_URL,
    analyticsPlan: "everything",
    path: "M 55.58 298.76 A 172 172 0 0 1 55.58 61.24 L 109.35 115.01 A 96 96 0 0 0 109.35 244.99 Z",
  },
];

const tickLines = Array.from({ length: 48 }, (_, index) => {
  const angle = (index / 48) * Math.PI * 2;
  const major = index % 4 === 0;
  const r1 = 179;
  const r2 = major ? 189 : 184;
  return {
    major,
    x1: (180 + r1 * Math.cos(angle)).toFixed(2),
    y1: (180 + r1 * Math.sin(angle)).toFixed(2),
    x2: (180 + r2 * Math.cos(angle)).toFixed(2),
    y2: (180 + r2 * Math.sin(angle)).toFixed(2),
  };
});

const active = nodes[0];
---

<section id={id} class:list={["pricing-radial", { section }]}>
  <div class="wrap pricing-radial-wrap">
    <div class="q-head">
      <span class="eyebrow">Pricing</span>
      <Heading class="p-title">Start free. Add more when you need it.</Heading>
    </div>

    <div class="r-grid">
      <article class="r-free">
        <svg class="corner-ribbon" viewBox="0 0 150 150" aria-hidden="true">
          <polygon class="rib-band" points="40,0 86,0 150,64 150,110"></polygon>
          <text
            class="rib-text"
            x="106.5"
            y="43.5"
            text-anchor="middle"
            dominant-baseline="central"
            transform="rotate(45 106.5 43.5)"
          >
            FOR MOST USERS
          </text>
        </svg>
        <div class="q-name">Free</div>
        <p class="q-tagline">
          A complete operating system to run your whole operation — for as long as you like.
        </p>
        <ul class="s-incl">
          {
            freeIncludes.map((item) => (
              <li>
                <span class="q-ck" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M5 12l5 5L20 6"></path>
                  </svg>
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <a
          href={SIGN_UP_URL}
          class="btn btn-primary"
          data-analytics-event="pricing_plan_clicked"
          data-analytics-placement={placement}
          data-analytics-plan="free"
          data-analytics-signup-start="true"
        >
          Start free <span class="arr" aria-hidden="true">→</span>
        </a>
        <div class="q-reassure">No card required · no time limit</div>
      </article>

      <article class="r-hud" data-pricing-radial>
        <script is:inline type="application/json" data-radial-nodes set:html={JSON.stringify(nodes)}></script>
        <div class="hud-tag">
          <span class="hud-tag-led"></span>
          <span>Advanced workflows</span>
        </div>

        <div
          class="wheel"
          data-wheel
          role="radiogroup"
          aria-label="Advanced workflow packages"
        >
          <svg class="wheel-svg" viewBox="0 0 360 360">
            {
              tickLines.map((tick) => (
                <line
                  class:list={["tick", { major: tick.major }]}
                  x1={tick.x1}
                  y1={tick.y1}
                  x2={tick.x2}
                  y2={tick.y2}
                />
              ))
            }
            {
              nodes.map((node, index) => (
                <path
                  class:list={["sector", { on: index === 0 }]}
                  d={node.path}
                  data-sector={index}
                  tabindex={index === 0 ? "0" : "-1"}
                  role="radio"
                  aria-checked={index === 0 ? "true" : "false"}
                  aria-label={`${node.name}, $${node.price} per month`}
                />
              ))
            }
          </svg>

          <div class="sector-label on" data-sector-label="0" style="left:50%;top:12.78%;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 2h6"></path><path d="M10 2v4.2L7.4 10.4A3.2 3.2 0 0 0 7 12v8a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-8a3.2 3.2 0 0 0-.4-1.6L14 6.2V2"></path><path d="M7 14h10"></path>
            </svg>
          </div>
          <div class="sector-label" data-sector-label="1" style="left:87.22%;top:50%;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22v-9"></path><path d="M12 13c0-3.6 2.9-5.5 6.5-5.5C18.5 11 15.6 13 12 13Z"></path><path d="M12 13c0-3.6-2.9-5.5-6.5-5.5C5.5 11 8.4 13 12 13Z"></path>
            </svg>
          </div>
          <div class="sector-label" data-sector-label="2" style="left:50%;top:87.22%;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 8 12 3.5 3 8l9 4.6L21 8Z"></path><path d="M3 8v8.2L12 21l9-4.8V8"></path><path d="M12 12.6V21"></path>
            </svg>
          </div>
          <div class="sector-label" data-sector-label="3" style="left:12.78%;top:50%;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.6"></rect><rect x="14" y="3" width="7" height="7" rx="1.6"></rect><rect x="3" y="14" width="7" height="7" rx="1.6"></rect><rect x="14" y="14" width="7" height="7" rx="1.6"></rect>
            </svg>
          </div>

          <div class="needle" data-needle style="transform: rotate(0deg);">
            <div class="pin"></div>
          </div>

          <div class="hub" aria-live="polite" aria-atomic="true">
            <span class="hub-eyebrow" data-hub-kind>{active.kind}</span>
            <div class="hub-name" data-hub-name>{active.name}</div>
            <div class="hub-price" data-hub-price>
              ${active.price}<span>/mo</span>
            </div>
            <a
              href={active.href}
              class="hub-btn"
              data-hub-link
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement={placement}
              data-analytics-plan={active.analyticsPlan}
              data-analytics-signup-start="true"
            >
              Choose <span class="arr" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="hud-detail">
          <p class="hud-desc" data-hud-desc>{active.desc}</p>
          <div class="hud-plugs" data-hud-plugs>
            {active.plugins.map((plugin) => <span class="hud-plug">{plugin}</span>)}
          </div>
        </div>

        <div class="hud-foot">
          <span class="alacarte">
            <b>Just one workflow?</b> Plugins are ${pluginPrice}/mo each — <a
              href={SIGN_UP_URL}
              data-analytics-event="pricing_plan_clicked"
              data-analytics-placement={placement}
              data-analytics-plan="plugin"
              data-analytics-signup-start="true"
            >see all →</a>
          </span>
        </div>
      </article>
    </div>
  </div>
</section>

<script is:inline>
  const roots = document.querySelectorAll("[data-pricing-radial]");

  roots.forEach((root) => {
    const dataEl = root.querySelector("[data-radial-nodes]");
    const wheel = root.querySelector("[data-wheel]");
    const sectors = Array.from(root.querySelectorAll("[data-sector]"));
    const labels = Array.from(root.querySelectorAll("[data-sector-label]"));
    const needle = root.querySelector("[data-needle]");
    const kind = root.querySelector("[data-hub-kind]");
    const name = root.querySelector("[data-hub-name]");
    const price = root.querySelector("[data-hub-price]");
    const link = root.querySelector("[data-hub-link]");
    const desc = root.querySelector("[data-hud-desc]");
    const plugs = root.querySelector("[data-hud-plugs]");
    const nodes = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    let active = 0;

    const setActive = (next) => {
      if (!nodes[next]) return;
      active = next;
      const node = nodes[next];
      sectors.forEach((sector, index) => {
        sector.classList.toggle("on", index === next);
        sector.setAttribute("aria-checked", index === next ? "true" : "false");
        sector.setAttribute("tabindex", index === next ? "0" : "-1");
      });
      labels.forEach((label, index) => {
        label.classList.toggle("on", index === next);
      });
      if (needle) needle.style.transform = `rotate(${node.angle + 90}deg)`;
      if (kind) kind.textContent = node.kind;
      if (name) name.textContent = node.name;
      if (price) price.innerHTML = `$${node.price}<span>/mo</span>`;
      if (link) {
        link.setAttribute("href", node.href);
        link.setAttribute("data-analytics-plan", node.analyticsPlan);
      }
      if (desc) desc.textContent = node.desc;
      if (plugs) {
        plugs.replaceChildren(
          ...node.plugins.map((plugin) => {
            const chip = document.createElement("span");
            chip.className = "hud-plug";
            chip.textContent = plugin;
            return chip;
          }),
        );
      }
    };

    wheel?.addEventListener("mousemove", (event) => {
      const rect = wheel.getBoundingClientRect();
      const dx = event.clientX - (rect.left + rect.width / 2);
      const dy = event.clientY - (rect.top + rect.height / 2);
      if (Math.hypot(dx, dy) < 92) return;
      const angle = (Math.atan2(dy, dx) * 180) / Math.PI;
      let best = 0;
      let bestDistance = 999;
      nodes.forEach((node, index) => {
        const distance = Math.abs(((angle - node.angle + 540) % 360) - 180);
        if (distance < bestDistance) {
          best = index;
          bestDistance = distance;
        }
      });
      if (best !== active) setActive(best);
    });

    sectors.forEach((sector, index) => {
      sector.addEventListener("mouseenter", () => setActive(index));
      sector.addEventListener("click", () => setActive(index));
      sector.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          setActive(index);
          return;
        }
        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          event.preventDefault();
          const next = (active + 1) % nodes.length;
          setActive(next);
          sectors[next]?.focus();
          return;
        }
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          event.preventDefault();
          const previous = (active - 1 + nodes.length) % nodes.length;
          setActive(previous);
          sectors[previous]?.focus();
        }
      });
    });
  });
</script>
