{
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/sales/orders",
      "permanent": false,
      "has": [{ "type": "cookie", "key": "better-auth.session_token" }]
    },
    {
      "source": "/",
      "destination": "/sales/orders",
      "permanent": false,
      "has": [{ "type": "cookie", "key": "__Secure-better-auth.session_token" }]
    },
    {
      "source": "/",
      "destination": "/sales/orders",
      "permanent": false,
      "has": [{ "type": "cookie", "key": "better-auth-session_token" }]
    },
    {
      "source": "/",
      "destination": "/sales/orders",
      "permanent": false,
      "has": [{ "type": "cookie", "key": "__Secure-better-auth-session_token" }]
    },
    { "source": "/login", "destination": "/sign-in", "permanent": false },
    { "source": "/documents", "destination": "/resources", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sign-in", "destination": "https://erp-orcin-pi.vercel.app/sign-in" },
    { "source": "/sign-up", "destination": "https://erp-orcin-pi.vercel.app/sign-up" },
    { "source": "/accept-invitation", "destination": "https://erp-orcin-pi.vercel.app/accept-invitation" },
    { "source": "/forgot-password", "destination": "https://erp-orcin-pi.vercel.app/forgot-password" },
    { "source": "/reset-password", "destination": "https://erp-orcin-pi.vercel.app/reset-password" },
    { "source": "/two-factor", "destination": "https://erp-orcin-pi.vercel.app/two-factor" },
    { "source": "/mfa-setup", "destination": "https://erp-orcin-pi.vercel.app/mfa-setup" },
    { "source": "/org-setup", "destination": "https://erp-orcin-pi.vercel.app/org-setup" },
    { "source": "/xero/sign-up/:path*", "destination": "https://erp-orcin-pi.vercel.app/xero/sign-up/:path*" },
    { "source": "/sales", "destination": "https://erp-orcin-pi.vercel.app/sales" },
    { "source": "/sales/:path*", "destination": "https://erp-orcin-pi.vercel.app/sales/:path*" },
    { "source": "/inventory", "destination": "https://erp-orcin-pi.vercel.app/inventory" },
    { "source": "/inventory/:path*", "destination": "https://erp-orcin-pi.vercel.app/inventory/:path*" },
    { "source": "/manufacturing", "destination": "https://erp-orcin-pi.vercel.app/manufacturing" },
    { "source": "/manufacturing/:path*", "destination": "https://erp-orcin-pi.vercel.app/manufacturing/:path*" },
    { "source": "/purchasing", "destination": "https://erp-orcin-pi.vercel.app/purchasing" },
    { "source": "/purchasing/:path*", "destination": "https://erp-orcin-pi.vercel.app/purchasing/:path*" },
    { "source": "/settings", "destination": "https://erp-orcin-pi.vercel.app/settings" },
    { "source": "/settings/:path*", "destination": "https://erp-orcin-pi.vercel.app/settings/:path*" },
    { "source": "/onboarding", "destination": "https://erp-orcin-pi.vercel.app/onboarding" },
    { "source": "/no-access", "destination": "https://erp-orcin-pi.vercel.app/no-access" },
    { "source": "/android", "destination": "https://erp-orcin-pi.vercel.app/android" },
    { "source": "/downloads/:path*", "destination": "https://erp-orcin-pi.vercel.app/downloads/:path*" },
    { "source": "/api/:path*", "destination": "https://erp-orcin-pi.vercel.app/api/:path*" },
    { "source": "/.well-known", "destination": "https://erp-orcin-pi.vercel.app/.well-known" },
    { "source": "/.well-known/:path*", "destination": "https://erp-orcin-pi.vercel.app/.well-known/:path*" },
    { "source": "/monitoring/:path*", "destination": "https://erp-orcin-pi.vercel.app/monitoring/:path*" }
  ]
}
