# App runtime database role (RLS enforced)
DATABASE_URL_APP=postgresql://app_user:password@localhost:5432/erp

# Owner database role (migrations only)
DATABASE_URL=postgresql://owner:password@localhost:5432/erp

# Set one canonical app URL. BETTER_AUTH_URL takes precedence if both are set.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for Better Auth session signing in non-production environments too.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Optional local override if you rely on PORT fallback logic.
# PORT=3000

# Optional email delivery for team invites.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Playwright override.
TEST_BASE_URL=http://localhost:3000
