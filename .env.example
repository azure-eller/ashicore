# Root checkout can use these directly.
# Worktrees should run `pnpm db:local:setup`, which writes worktree-local DB URLs and auto-starts local Postgres if needed.

# App runtime database role (RLS enforced)
DATABASE_URL_APP=postgresql://app_user:postgres@127.0.0.1:5432/erp_local

# Owner database role (migrations only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/erp_local

# Set one canonical app URL for emails and non-request auth fallbacks.
# Production: https://ashicore.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same-domain public site deployments should point ERP Next assets at the ERP
# project's stable production origin so ashicore.app does not proxy /_next/*.
# NEXT_PUBLIC_ERP_ASSET_ORIGIN=https://ashicore-erp.vercel.app

# Optional comma-separated host patterns for alternate dev hosts.
# localhost, 127.0.0.1, and [::1] on any port are already allowed.
# BETTER_AUTH_ALLOWED_HOSTS=192.168.1.25:3001,erp-dev.tailnet.ts.net

# Required for Better Auth session signing in non-production environments too.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Optional local override if you rely on PORT fallback logic.
# PORT=3000

# Required in production for invites, password reset, and email verification.
# Default sender in code: Ashicore <noreply@ashicore.app>
RESEND_API_KEY=
EMAIL_FROM="Ashicore <noreply@ashicore.app>"
# Optional comma-separated internal recipients for founder alerts on signups and billing events.
ASHICORE_ALERT_EMAILS=

# Optional display name for transactional emails (defaults to "Ashicore").
APP_NAME=

# Required in production for server-side error capture.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional Sentry build-time config for source maps and release tagging.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# Optional Playwright override.
TEST_BASE_URL=http://localhost:3000

# Xero integration (create a Xero developer app and set its redirect URI
# to XERO_REDIRECT_URI). Required only if you plan to connect Xero.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
# Required when connecting or using Xero. Generate with:
#   openssl rand -base64 32
XERO_TOKEN_ENCRYPTION_KEY=
XERO_TOKEN_ENCRYPTION_KEY_ID=default
# Production key rotation uses the multi-key map plus active key id.
# Rotate with: pnpm rotate:xero-token-key -- --environment production --apply
# XERO_TOKEN_ENCRYPTION_KEYS={"default":"<base64-key>","xero_2026_05":"<base64-key>"}
