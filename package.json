{
  "name": "ashicore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev --disable-source-maps",
    "preflight": "tsx scripts/verify-worktree-safety.ts",
    "boot": "tsx scripts/agent-up.ts",
    "servers": "tsx scripts/dev-servers.ts",
    "build": "pnpm preflight && next build",
    "start": "next start",
    "lint": "pnpm preflight && eslint && pnpm verify:editable-lines && pnpm verify:schema-timestamps && pnpm verify:migration-order && pnpm verify:drizzle-snapshots && pnpm verify:app-user-grants && pnpm verify:inventory-kernel && pnpm verify:paonia-loader-shipping && pnpm verify:fast-heartbeat && pnpm verify:slow-stories && pnpm --filter @ashicore/www lint",
    "db:local:start": "tsx scripts/local-db-cli.ts start",
    "db:local:stop": "tsx scripts/local-db-cli.ts stop",
    "db:local:setup": "tsx scripts/setup-local-db.ts",
    "dev:seed-user": "tsx scripts/seed-dev-user.ts",
    "seed:docs-demo": "tsx scripts/seed-docs-demo.ts",
    "docs:shots": "tsx scripts/seed-docs-demo.ts && tsx scripts/capture-docs-shots.ts",
    "xero:smoke": "tsx scripts/xero-smoke.ts",
    "quickbooks:smoke": "tsx scripts/quickbooks-smoke.ts",
    "shopify:smoke": "tsx scripts/shopify-smoke.ts",
    "verify:xero-token-crypto": "tsx scripts/verify-xero-token-crypto.ts",
    "verify:editable-lines": "tsx scripts/verify-editable-lines.ts",
    "rotate:xero-token-key": "tsx scripts/rotate-xero-token-key.ts",
