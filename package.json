{
  "name": "erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local:start": "tsx scripts/local-db-cli.ts start",
    "db:local:stop": "tsx scripts/local-db-cli.ts stop",
    "db:local:setup": "tsx scripts/setup-local-db.ts",
    "dev:seed-user": "tsx scripts/seed-dev-user.ts",
    "xero:smoke": "tsx scripts/xero-smoke.ts",
    "load:paonia": "tsx scripts/load/paonia.ts",
    "load:paonia:dry-run": "tsx scripts/load/paonia.ts --dry-run",
    "load:paonia:reset": "tsx scripts/load/paonia.ts --reset",
    "load:paonia:reload": "tsx scripts/load/paonia.ts --reset --reload",
    "diff:projections": "tsx scripts/diff-projections.ts",
    "verify:inventory-state": "tsx scripts/verify-inventory-state.ts",
    "verify:inventory-kernel": "tsx scripts/verify-inventory-kernel.ts",
    "verify:opening-stock-conversion": "tsx scripts/verify-opening-stock-conversion.ts",
    "verify:paonia-loader-data": "tsx scripts/verify-paonia-loader-data.ts",
    "verify:paonia-katana-skus": "tsx scripts/verify-paonia-katana-skus.ts",
    "verify:inventory": "pnpm verify:inventory-kernel && pnpm verify:inventory-state",
    "db:generate": "drizzle-kit generate && tsx scripts/make-migrations-idempotent.ts",
    "db:check-migrations": "tsx scripts/make-migrations-idempotent.ts --check",
    "worktree:cleanup": "tsx scripts/cleanup-worktree.ts",
    "cleanup": "tsx scripts/cleanup-worktree.ts",
    "test": "pnpm test:e2e:fast",
    "test:e2e:fast": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast --workers=${PLAYWRIGHT_FAST_WORKERS:-8}",
    "test:e2e:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow",
    "test:reconciliation": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/reconciliation",
    "test:e2e:sections": "pnpm test:e2e:fast",
    "test:e2e:all": "pnpm test:e2e:fast && pnpm test:e2e:slow && pnpm test:e2e:auth",
    "test:e2e:inventory": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/inventory-write.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-8}",
    "test:e2e:inventory:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/inventory-form.spec.ts",
    "test:e2e:purchasing": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/purchasing-write.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-8}",
    "test:e2e:purchasing:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/purchasing-order.spec.ts",
    "test:e2e:stocktake": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/stocktake-write.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-8}",
    "test:e2e:stocktake:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/stocktake.spec.ts",
    "test:e2e:manufacturing": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/manufacturing-write.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-8}",
    "test:e2e:manufacturing:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/manufacturing-order.spec.ts",
    "test:e2e:sales": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/sales-write.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-8}",
    "test:e2e:sales:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/sales-order.spec.ts",
    "test:e2e:auth": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/auth-security.spec.ts test/e2e/team-management.spec.ts",
    "test:inventory": "pnpm test:e2e:inventory",
    "test:sales": "pnpm test:e2e:sales"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@hookform/resolvers": "^5.2.2",
    "@hugeicons/core-free-icons": "^3.3.0",
    "@hugeicons/react": "^1.1.5",
    "@ncdai/react-wheel-picker": "^1.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/components": "^1.0.11",
    "@react-pdf/renderer": "^4.5.0",
    "@sentry/nextjs": "^10.47.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convert": "^7.0.0",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xero-node": "^15.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
