    "cleanup": "tsx scripts/cleanup-worktree.ts",
    "test": "pnpm test:fast",
    "test:fast": "pnpm test:e2e:fast",
    "test:e2e:fast": "NODE_OPTIONS='--conditions react-server' EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast --workers=${PLAYWRIGHT_FAST_WORKERS:-2}",
    "test:scratch": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/scratch --workers=1",
    "test:invariants": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/invariants.spec.ts --workers=1",
