    "test:reconciliation": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/reconciliation",
    "test:e2e:sections": "pnpm test:fast",
    "test:e2e:all": "pnpm test:fast && pnpm test:slow && pnpm test:slow:auth",
    "test:fast:inventory": "pnpm test:e2e:inventory",
    "test:e2e:inventory": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/inventory-mutation-kernel.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-2}",
    "test:slow:purchasing": "pnpm test:e2e:purchasing:slow",
    "test:e2e:purchasing:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/purchasing-receiving.spec.ts",
    "test:slow:stocktake": "pnpm test:e2e:stocktake:slow",
    "test:e2e:stocktake:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/stocktake-workflow.spec.ts",
    "test:fast:manufacturing": "pnpm test:e2e:manufacturing",
    "test:e2e:manufacturing": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/manufacturing-demand-and-completion.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-2}",
    "test:slow:manufacturing": "pnpm test:e2e:manufacturing:slow",
    "test:e2e:manufacturing:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/manufacturing-execution.spec.ts",
    "test:fast:sales": "pnpm test:e2e:sales",
    "test:e2e:sales": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/sales-demand-and-shipment.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-2}",
    "test:fast:purchasing": "pnpm test:e2e:purchasing",
    "test:e2e:purchasing": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/purchasing-supply-and-receipt.spec.ts test/e2e/fast/xero-purchase-bill-gates.spec.ts --workers=${PLAYWRIGHT_FAST_WORKERS:-2}",
    "test:fast:planning": "pnpm test:e2e:planning",
    "test:e2e:planning": "NODE_OPTIONS='--conditions react-server' EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/fast/planning-demand-queue.spec.ts --workers=1",
    "test:slow:planning": "pnpm test:e2e:planning:slow",
    "test:e2e:planning:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/planning-demand-queue-story.spec.ts",
    "test:slow:sales": "pnpm test:e2e:sales:slow",
    "test:e2e:sales:slow": "EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/slow/sales-fulfillment.spec.ts test/e2e/slow/pricing-scenarios-story.spec.ts",
    "test:slow:auth": "pnpm test:e2e:auth",
    "test:e2e:auth": "BETTER_AUTH_RATE_LIMIT_DISABLED=1 EMAIL_OUTBOX_ONLY=1 playwright test test/e2e/auth-security.spec.ts test/e2e/team-access.spec.ts",
    "test:inventory": "pnpm test:fast:inventory",
    "test:sales": "pnpm test:fast:sales"
